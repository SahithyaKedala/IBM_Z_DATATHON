# ==============================================================================
# VectorVision Backend - IBM Z / LinuxONE (s390x & amd64) Multi-Arch Container
# ==============================================================================
FROM python:3.11-slim-bookworm

# Metadata for IBM Z / LinuxONE Community & OpenShift
LABEL maintainer="VectorVision Team"
LABEL platform="IBM LinuxONE / OpenShift s390x & x86_64"
LABEL description="AI-Driven Emergency Dispatch & Resource Optimization Engine"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PORT=8000

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source
COPY backend/app ./app

# OpenShift / LinuxONE Security: Run as non-root user (Arbitrary UID support)
RUN useradd -u 10001 -m -s /bin/bash vectorvision && \
    chown -R 10001:0 /app && \
    chmod -R g=u /app

USER 10001

EXPOSE 8000

HEALTHCHECK --interval=20s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
